        type: integer
        min: 1
        max: 4
      response_format:
        type: string
        enum: [url, b64_json]
      max_reference_images:
        type: integer
        min: 0
        max: 16
      concurrency:
        type: integer
        min: 1
        max: 10
      storyboard_keyframe_generation_concurrency:
        type: integer
        min: 1
        max: 10
      storyboard_keyframe_concurrency:
        type: integer
        min: 1
        max: 10
      output_dir:
        type: string
      layout_image_generation_concurrency:
        type: integer
        min: 1
        max: 10
      prop_image_generation_concurrency:
        type: integer
        min: 1
        max: 10
      roleboard_prompt_template:
        type: string
      prompt_template:
