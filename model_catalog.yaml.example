        max: 5
      video_generation_concurrency:
        type: integer
        min: 1
        max: 5
      max_concurrent_videos:
        type: integer
        min: 1
        max: 5

  volcengine:seed-tts-2.0:
    provider: volcengine
    family: seed-tts
    capability: audio
    input_modalities: [text]
    output_modalities: [audio]
    limits:
      max_generated_audio_duration_seconds: 10
    params_schema:
      sample_rate:
        type: integer
        enum: [16000, 24000, 48000]
      response_format:
        type: string
        enum: [mp3, wav, pcm]
      max_generated_audio_duration_seconds:
        type: number
        min: 1

  minimax:music-2.6:
    provider: minimax
    family: minimax-music
    capability: music
    input_modalities: [text]
    output_modalities: [audio]
    limits:
      max_duration_seconds: 240
    params_schema:
      sample_rate:
        type: integer
        enum: [16000, 24000, 32000, 44100]
      bitrate:
        type: integer
        min: 32000
      format:
        type: string
        enum: [mp3, wav, pcm]
      output_format:
        type: string
        enum: [url, hex]
      is_instrumental:
        type: boolean
      lyrics_optimizer:
        type: boolean
      aigc_watermark:
        type: boolean
      duration:
        type: number
        min: 1
        max: 240

  elevenlabs:music_v1:
    provider: elevenlabs
    family: elevenlabs-music
    capability: music
    input_modalities: [text]
    output_modalities: [audio]
    limits:
      max_duration_seconds: 300
    params_schema:
      output_format:
        type: string
      force_instrumental:
        type: boolean
      respect_sections_durations:
        type: boolean
      duration:
        type: number
        min: 1
        max: 300

  aliyun_omni:qwen3.5-omni-plus:
