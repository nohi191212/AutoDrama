models:
  aliyun:qwen-plus:
    provider: aliyun
    family: qwen
    capability: text
    input_modalities: [text]
    output_modalities: [json]
    limits:
      max_output_tokens: 8192
    params_schema:
      temperature:
        type: number
        min: 0
        max: 2
      response_format:
        type: string
        enum: [json_object, text]
      prompt_template:
        type: string
      max_iterations:
        type: integer
        min: 2
        max: 20

  rightcode:gpt-5.5:
    provider: rightcode
    family: gpt
    capability: text
    input_modalities: [text]
    output_modalities: [json]
    limits:
      max_output_tokens: 8192
    params_schema:
      temperature:
        type: number
        min: 0
        max: 2
      response_format:
        type: string
        enum: [json_object, text]
      reasoning_effort:
        type: string
        enum: [low, medium, high, xhigh]
      console_stream:
        type: boolean
      prompt_template:
        type: string
      storyboard_prompt_concurrency:
        type: integer
        min: 1
        max: 8
      storyboard_prompt_batch_concurrency:
        type: integer
        min: 1
        max: 8
      text_generation_concurrency:
        type: integer
        min: 1
        max: 8
      max_concurrent_text_calls:
        type: integer
        min: 1
        max: 8
      concurrency:
        type: integer
        min: 1
        max: 8
      max_iterations:
        type: integer
        min: 2
        max: 20

  deepseek:deepseek-v4-pro:
    provider: deepseek
    family: deepseek
    capability: text
    input_modalities: [text]
    output_modalities: [json]
    limits:
      max_output_tokens: 8192
    params_schema:
      temperature:
        type: number
        min: 0
        max: 2
      reasoning_effort:
        type: string
        enum: [low, medium, high, max]
      thinking_enabled:
        type: boolean
      prompt_template:
        type: string
      max_iterations:
        type: integer
        min: 2
        max: 20

  deepseek:deepseek-v4-flash:
    provider: deepseek
    family: deepseek
    capability: text
    input_modalities: [text]
    output_modalities: [json]
    limits:
      max_output_tokens: 8192
    params_schema:
      temperature:
        type: number
        min: 0
        max: 2
      reasoning_effort:
        type: string
        enum: [low, medium, high, max]
      thinking_enabled:
        type: boolean
      prompt_template:
        type: string
      max_iterations:
        type: integer
        min: 2
        max: 20

  google:gemini-3.5-flash:
    provider: google
    family: gemini
    capability: text
    input_modalities: [text]
    output_modalities: [json]
    limits:
      max_output_tokens: 8192
    params_schema:
      temperature:
        type: number
        min: 0
        max: 2
      response_format:
        type: string
        enum: [json_object, text]
      max_output_tokens:
        type: integer
        min: 1
      thinking_level:
        type: string
      prompt_template:
        type: string
      max_iterations:
        type: integer
        min: 2
        max: 20

  aibox:gpt-image-2:
