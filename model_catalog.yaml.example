  volcengine:doubao-seedance-2-0-260128:
    provider: volcengine
    family: seedance
    capability: video
    input_modalities: [text, image, audio, video]
    output_modalities: [video, image]
    limits:
      min_duration_seconds: 4
      max_duration_seconds: 10
      max_reference_images: 4
      max_reference_audio: 1
      max_reference_videos: 2
    params_schema:
      ratio:
        type: string
        enum: ["16:9", "9:16", "1:1"]
      resolution:
        type: string
        enum: [720p, 1080p]
      duration:
        type: integer
        min: 4
        max: 10
      generate_audio:
        type: boolean
