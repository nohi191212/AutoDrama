    limits:
      min_duration_seconds: 3
      max_duration_seconds: 15
      max_reference_images: 3
      max_reference_elements: 3
      max_reference_audio: 0
      max_reference_videos: 0
    params_schema:
      aspect_ratio:
        type: string
        enum: ["16:9", "9:16", "1:1"]
      ratio:
        type: string
        enum: ["16:9", "9:16", "1:1"]
      mode:
        type: string
        enum: [std, pro, 4k]
      duration:
        type: integer
        min: 3
        max: 15
      sound:
        type: string
        enum: ["on", "off"]
      watermark:
        type: boolean
      prompt_template:
        type: string
      negative_rules:
        type: array
      max_reference_images:
