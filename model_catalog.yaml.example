          - "1536x1024"
          - "960x1280"
          - "1280x960"
          - "1088x1920"
          - "1920x1088"
          - "2048x2048"
          - "2048x3072"
          - "3072x2048"
          - "1920x2560"
          - "2560x1920"
          - "1440x2560"
          - "2560x1440"
          - "2880x2880"
          - "2304x3456"
          - "3456x2304"
          - "2400x3200"
          - "3200x2400"
          - "2160x3840"
          - "3840x2160"
      resolution:
