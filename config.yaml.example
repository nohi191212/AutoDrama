app:
  env: dev
  default_quality_preset: cheap
  enable_human_review: false

project:
  # Stable ID is recommended because resume relies on it.
  id: review_demo
  title: 测试短片
  script_outline_file: ./inputs/story_outline.md
  # The script pipeline lets the text model split the story into this many episodes.
  episode_count: 1
  # Target duration for each episode, in seconds.
  episode_duration_seconds: 30
  # Visual style for character images, scene images, and downstream video prompts.
  # Supported values: live_action, anime_2d, anime_3d
  # Chinese aliases are also accepted: 真人电影质感, 2D动漫, 3D动漫
  visual_style: live_action

output:
  # All generated assets are saved under this directory.
  # Relative paths are resolved from the working directory.
  root_dir: ./outputs
  project_dir_template: "{date}_{slug}"
  db_filename: autodrama.sqlite
  subdirs:
    logs: logs
    assets: assets
    outputs: outputs
    images: assets/images
    videos: assets/videos
    audios: assets/audios
    json: assets/json

runtime:
  python:
    # The key is selected by scripts/env.sh after platform detection.
    # Supported keys: windows, macos, linux, default.
    windows: D:/miniforge3/envs/autodrama/python.exe
    linux: python3
    macos: python3
    default: python3
  max_text_retry: 3
  max_media_retry: 2
  request_timeout_seconds: 120
  ffmpeg_path: ffmpeg

budget:
  max_total_cny: 100
  max_image_count: 20
  max_video_seconds: 45
  max_music_count: 5
  max_text_calls: 200

providers:
  aliyun:
    base_url: https://dashscope.aliyuncs.com
    api_key_env: DASHSCOPE_API_KEY
    models:
      text: qwen-plus
      voice_design: voice-enrollment
      voice_clone: voice-enrollment
      target_model: qwen3-tts-vd-2026-01-26
      clone_target_model: qwen3-tts-vc-2026-01-22
      vision: qwen-vl-max
      omni: qwen-omni-turbo
      music: fun-music-v1
      image: wan2.7-image-pro
      text_to_video: wan2.7-t2v-2026-04-25
    options:
      text_response_format: true
      language: zh
      sample_rate: 24000
      response_format: wav
      websocket_url: wss://dashscope.aliyuncs.com/api-ws/v1/inference
      music_format: mp3
      music_gender: female
      enable_aigc_watermark: false
      image_size: 2K
      n: 1
      thinking_mode: true
      resolution: 720P
      ratio: "16:9"
      prompt_extend: true
      watermark: false
      poll_interval_seconds: 15
      max_polls: 80

  rightcode:
    base_url: https://www.right.codes/draw
    api_key_env: RIGHTCODE_API_KEY
    models:
      image: gpt-image-2
    options:
      size: 1024x1024
      n: 1

  deepseek:
    base_url: https://api.deepseek.com
    api_key_env: DEEPSEEK_API_KEY
    models:
      text: deepseek-v4-pro
    options:
      reasoning_effort: high
      thinking_enabled: true

  minimax:
    base_url: https://api.minimax.chat
    api_key_env: MINIMAX_API_KEY
    group_id_env: MINIMAX_GROUP_ID
    models:
      tts: speech-02
      music: music-01

  volcengine:
    base_url: https://openspeech.bytedance.com
    region: cn-beijing
    api_key_env: VOLCENGINE_API_KEY
    app_id_env: VOLCENGINE_APP_ID
    access_key_env: VOLCENGINE_ACCESS_KEY
    secret_key_env: VOLCENGINE_SECRET_KEY
    models:
      voice_design: voice_design
      voice_clone: voice_clone
      tts: seed-icl-2.0
      target_model: seed-icl-2.0
      clone_target_model: seed-icl-2.0
      image: seedream-lite
      video: seedance-lite
      upscale: video-upscale
    options:
      language: cn
      sample_rate: 24000
      response_format: mp3
      # Volcengine voice design/clone requires pre-allocated speaker IDs from the console.
      # Fill this list with enough IDs for each generated role/emotion voice in a run.
      speaker_id_pool: []
      poll_interval_seconds: 5
      max_polls: 60
      voice_clone_extra_params:
        voice_clone_denoise_model_id: ""
        enable_audio_denoise: false

routing:
  text:
    script: aliyun
    role: deepseek
    prop: deepseek
    layout: deepseek
    storyboard: deepseek
    edit_plan: aliyun
    bgm_plan: aliyun
  image:
    role: rightcode
    prop: rightcode
    layout: rightcode
    ref_frame: rightcode
  video:
    shot: aliyun
    upscale: volcengine
  audio:
    speech: volcengine
    music: minimax
  music:
    bgm: aliyun
  vision:
    media_review: aliyun
