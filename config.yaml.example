app:
  env: dev
  default_quality_preset: cheap
  enable_human_review: false

apikeys_file: ./apikeys.yaml
model_catalog_file: ./model_catalog.yaml.example

# Node-level model bindings. If a node is omitted here, AutoDrama falls back to the legacy routing section.
# Params are validated against model_catalog_file when the config is loaded.
nodes:
  script_outline:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.4
      response_format: json_object
  script_novel:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.7
      response_format: json_object
  script_novel_extract:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.3
      response_format: json_object
  key_vision_prompt:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.45
      response_format: json_object
  key_vision_image_generation:
    model: aibox:gpt-image-2-guan
    params:
      size: 2160x3840
  role_extract_primary:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.3
      response_format: json_object
  role_extract_functional:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.3
      response_format: json_object
  role_episode_key_audit:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.2
      response_format: json_object
  role_duplicate_audit:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.2
      response_format: json_object
  ambient_entity_extract:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.3
      response_format: json_object
  roleboard_prompt:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.4
      response_format: json_object
  roleboard_image_generation:
    model: aibox:gpt-image-2-guan
    params:
      roleboard_prompt_template: aibox_gpt_image_2_guan
      roleboard_image_generation_concurrency: 3
      anchor_role: ""
      anchor_appearance: base
      size: 3840x2160
  role_subject_frontal_image_generation:
    model: aibox:gpt-image-2-guan
    params:
      size: 1088x1920
      quality: high
      image_generation_concurrency: 3
  clip_to_shots:
    model: rightcode:gpt-5.6-terra
    params:
      temperature: 0.35
      response_format: json_object
  layout_to_background_prompt:
    model: aibox:gemini-3.5-flash
    params:
      temperature: 0.25
  shot_background_image_generation:
    model: aibox:gpt-image-2-guan
    params:
      concurrency: 2
      size: 1088x1920
  shot_keyframe_prompt:
    model: aibox:gemini-3.5-flash
    params:
      temperature: 0.3
      negative_prompt: >-
        extra people, duplicate bodies, identity drift, malformed hands,
        inconsistent scale, floating objects, text, subtitles, logo, watermark
  shot_keyframe_image_generation:
    model: aibox:gpt-image-2-guan
    params:
      concurrency: 2
      size: 1088x1920
  shot_manifest_generation:
    params: {}
  prop_extract:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.3
      response_format: json_object
  prop_finalize:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.2
      response_format: json_object
      max_iterations: 1
  prop_prompt:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.4
      response_format: json_object
  prop_image_generation:
    model: aibox:gpt-image-2-guan
    params:
      size: 2048x2048
      prop_image_generation_concurrency: 1
      max_attempts: 5
  layout_extract:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.3
      response_format: json_object
  layout_prompt:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.4
      response_format: json_object
  layout_finalize:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.2
      response_format: json_object
      max_iterations: 1
  layout_prop_boundary_review:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.2
      response_format: json_object
  layout_image_generation:
    model: aibox:gpt-image-2-guan
    params:
      size: 2160x3840
      concurrency: 3
  bgm_design:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: xhigh
      temperature: 0.4
      response_format: json_object
  bgm_generation:
    model: minimax:music-2.6
    params:
      format: mp3
      sample_rate: 44100
      output_format: url
      is_instrumental: true
  shot_video_generation:
    model: volcengine:doubao-seedance-2-0-260128
    params:
      prompt_template: volcengine
      shot_video_generation_concurrency: 5
  # Optional Kling 3.0 Omni native-audio branch. Switch these bindings plus routing.video.shot to kling.
  # role_kling_voice_generation auto-selects an official voice; role_voice_map is optional override.
  # It resolves preset/custom voices, then
  # role_subject_element_generation binds each voice_id to the reusable role subject.
  # role_kling_voice_generation:
  #   model: kling:kling-v3-omni
  #   params:
  #     require_dialogue_voice: true
  # role_subject_video_generation:
  #   model: kling:kling-v3-omni
  #   params:
  #     aspect_ratio: "9:16"
  #     mode: pro
  #     sound: "on"
  #     watermark: false
  #     max_reference_images: 2
  #     max_reference_elements: 3
  #     role_subject_video_generation_concurrency: 5
  # role_subject_video_intro_text:
  #   model: rightcode:gpt-5.6-terra
  #   params:
  #     reasoning_effort: low
  #     temperature: 0.5
  #     response_format: json_object
  # role_subject_element_generation:
  #   model: kling:kling-v3-omni
  #   params:
  #     aspect_ratio: "9:16"
  #     mode: pro
  #     sound: "on"
  #     watermark: false
  #     subject_reference_type: image_refer
  # shot_video_generation:
  #   model: kling:kling-v3-omni
  #   params:
  #     aspect_ratio: "9:16"
  #     mode: pro
  #     audio: native
  #     resolution: 1080p
  #     multi_shot: true
  #     watermark: false
  #     prompt_template: kling
  #     negative_rules:
  #       - 无字幕、无logo、无水印、无分格线、无面板编号、不要直接展示参考图版式或三视图布局。
  #       - 不要生成参考图拼版、三视图布局、宫格或面板编号；角色身份与音色以 subject element 为准。
  #     max_reference_images: 7
  #     shot_video_generation_concurrency: 5
  shot_dialogue_audio_generation:
    model: volcengine:seed-tts-2.0
    params:
      sample_rate: 24000
      response_format: mp3
      max_generated_audio_duration_seconds: 10
  role_voice_select:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: low
      temperature: 0.2
      response_format: json_object
  role_voice_select_audio_judge:
    model: aliyun_omni:qwen3.5-omni-plus
    params:
      temperature: 0.2
  image_prompt_safety_rewrite:
    model: rightcode:gpt-5.6-terra
    params:
      reasoning_effort: low
      temperature: 0.2
      response_format: json_object
  postgen_edit_plan_generation:
    model: google:gemini-3.5-flash
    params:
      temperature: 0.2
      response_format: json_object

project:
  # Stable ID is recommended because resume relies on it.
  id: review_demo
  title: 测试短片
  script_outline_file: ./inputs/story_outline.md
  # The script pipeline lets the text model split the story into this many episodes.
  episode_count: 1
  # Target duration for each episode, in seconds.
  episode_duration_seconds: 30
  # Exact number of reusable BGM tracks; set 0 to skip BGM design/generation.
  bgm_count: 3
output:
  # All generated assets are saved under this directory.
  # Relative paths are resolved from the working directory.
  root_dir: ./outputs
  project_dir_template: "{date}_{slug}"
  db_filename: autodrama.sqlite
  subdirs:
    logs: logs
    assets: assets
    outputs: outputs
    images: assets/images
    videos: assets/videos
    audios: assets/audios
    json: assets/json

runtime:
  python:
    # The key is selected by scripts/env.sh after platform detection.
    # Supported keys: windows, macos, linux, default.
    windows: D:/miniforge3/envs/autodrama/python.exe
    linux: python3
    macos: python3
    default: python3
  max_text_retry: 3
  max_media_retry: 2
  request_timeout_seconds: 120
  ffmpeg_path: ffmpeg

budget:
  max_total_cny: 100
  max_image_count: 20
  max_video_seconds: 45
  max_music_count: 5
  max_text_calls: 200

generation:
  # -1 generates the full episode. A positive value keeps full clip planning,
  # then limits expensive downstream work to the smallest complete clip prefix
  # whose normalized shot durations reach this per-episode target.
  expected_output_seconds: -1
  # Used by roleboard_image_generation as Image 2 style references.
  roleboard_style_reference_dir: ./.assets/sample
  # Versioned visual contract consumed by all visual generation nodes.
  visual_style:
    schema_version: 2
    medium: stylized_3d_cg
    render_engine_language:
      - 国漫 CG 动画电影短剧主视觉，人物、场景、道具和光影属于同一美术体系。
      - 画面具有明确戏剧冲突、纵深层次和电影镜头感。
    materials: [风格化皮肤, 布料, 金属, 石材]
    palette: [克制主色, 清晰视觉记忆点]
    lighting: [电影化主光, 明确空间层次]
    camera: [竖屏构图, 戏剧性景别, 清晰主体关系]
    negative_constraints: [真人照片质感, 可读文字, 字幕, 水印, logo, 无关装饰]
  # Unified role image style prompt used by roleboard_prompt and roleboard_image_generation.
  roleboard_style_prompt: >
    使用参考图片作为统一人物美术风格、材质质感、光影、色彩和画面气质参考。
    人物保持国漫CG/动画电影角色质感，明显非真人摄影，脸部为风格化CG美术表现，
    避免真实人脸毛孔、汗渍、微血管等照片级细节。保留东方修仙题材的服饰层次、
    旧布料、金属、石材和随身道具材质差异。背景保持干净，除指定角色名和视图标签外，
    不出现其他文字、水印或logo。
  prop_design_style_prompt: >
    道具图保持国漫CG/动画电影资产设定图质感，材质区分清楚，轮廓完整可读；
    光影干净，背景简洁，无人物、无手持、无文字、水印或logo。重点表现尺寸比例、
    材质、磨损、能量状态和一眼可识别的结构细节。
  layout_design_style_prompt: >
    场景图保持国漫CG/动画电影无人物场景三视图设定板质感，空间结构清晰；
    顶视平面、正向主视和侧向/45度透视必须统一为同一个空间，用于后续短剧取景参考。
    材质、光源、阴影、空气粒子和色彩关系稳定可复用，适配16:9横向资产设定板和9:16短剧镜头取景。
    不出现人物、背影、手、剪影、字幕、水印、文字标识或无关logo。

postgen:
  max_source_clips_per_plan: 9
  render_width: 720
  render_height: 1280
  fps: 25
  burn_subtitles: true
  # Use deterministic for local dry-runs; llm calls routing.text.postgen_edit_plan.
  edit_plan_mode: llm
  keep_tmp_cuts: true
  voice_alignment:
    enabled: false
    demucs_model: htdemucs
    demucs_device: cpu
    diarization_model: pyannote/speaker-diarization-3.1
    huggingface_token_env: HUGGINGFACE_TOKEN
    speaker_role_map:
      episode_001:SPEAKER_00: role_a
      episode_001:SPEAKER_01: role_b
    role_rvc_models:
      role_a: ./models/rvc/role_a.pth
      role_b: ./models/rvc/role_b.pth
    speaker_rvc_models:
      SPEAKER_00: ./models/rvc/role_a.pth
      SPEAKER_01: ./models/rvc/role_b.pth
    rvc_command: []
    fail_on_unmapped_speaker: true
  subtitles:
    enabled: false
    backend: whisperx
    model: large-v3
    language: zh
    device: cpu
    compute_type: int8
    batch_size: 4
    max_chars_per_line: 18
    max_lines: 2
    font_name: Microsoft YaHei
  audit:
    enabled: false
    source_asr: true
    source_audit: true
    final_audit: true
    frame_count: 9
    include_audio: true
    fail_on_reject: false
    max_output_tokens: 8192

providers:
  aliyun:
    base_url: https://dashscope.aliyuncs.com
    api_key_env: ALIYUN_API_KEY
    models:
      text: qwen-plus
      voice_design: voice-enrollment
      voice_clone: voice-enrollment
      target_model: qwen3-tts-vd-2026-01-26
      clone_target_model: qwen3-tts-vc-2026-01-22
      vision: qwen-vl-max
      omni: qwen-omni-turbo
      music: fun-music-v1
      image: wan2.7-image-pro
      text_to_video: wan2.7-t2v-2026-04-25
    options:
      text_response_format: true
      language: zh
      sample_rate: 24000
      response_format: wav
      websocket_url: wss://dashscope.aliyuncs.com/api-ws/v1/inference
      music_format: mp3
      music_gender: female
      enable_aigc_watermark: false
      image_size: 2K
      n: 1
      thinking_mode: true
      resolution: 720P
      ratio: "16:9"
      prompt_extend: true
      watermark: false
      poll_interval_seconds: 15
      max_polls: 80

  aliyun_omni:
    base_url: https://dashscope.aliyuncs.com
    api_key_env: ALIYUN_API_KEY
    models:
      audio_judge: qwen3.5-omni-plus
    options:
      omni_response_format: false

  rightcode:
    base_url: https://www.right.codes/draw
    api_key_env: RIGHTCODE_API_KEY
    models:
      text: gpt-5.6-terra
      shot: gpt-5.6-terra
      image: gpt-image-2
      # Used by key_vision_image_generation for the global key visual original.
      key_vision: gpt-image-2
      # Used by roleboard_image_generation for role identity boards.
      roleboard: gpt-image-2-vip
    options:
      text_response_format: true
      reasoning_effort: xhigh
      shot_reasoning_effort: xhigh
      size: 1024x1024
      # Used by roleboard_image_generation for role identity boards.
      roleboard_size: 3840x2160
      roleboard_quality: high
      # Used by key_vision_image_generation for the global key visual original.
      key_vision_size: 1024x1536
      key_vision_quality: high
      n: 1

  aibox:
    base_url: https://api.lk888.ai
    api_key_env: AIBOX_API_KEY
    models:
      text: gemini-3.5-flash
      postgen_audit: gemini-3.5-flash
      image: gpt-image-2-guan
      key_vision: gpt-image-2-guan
      roleboard: gpt-image-2-guan
      shot: gpt-image-2-guan
      prop: gpt-image-2-guan
      layout: gpt-image-2-guan
    options:
      size: auto
      quality: auto
      key_vision_size: 2160x3840
      roleboard_size: 3840x2160
      shot_size: 2048x2048
      prop_size: 2048x2048
      layout_size: 2160x3840
      max_reference_images: 14
      aibox_request_timeout_seconds: 60
      aibox_max_attempts: 3
      aibox_retry_initial_delay_seconds: 2
      aibox_retry_max_delay_seconds: 30
      poll_interval_seconds: 4
      max_wait_seconds: 900

  toapi:
    base_url: https://toapis.com
    api_key_env: TOAPI_API_KEY
    models:
      image: gpt-image-2
      # Used by key_vision_image_generation for the global key visual original.
      key_vision: gpt-image-2
      # Used by roleboard_image_generation for the final 16:9 role identity board.
      roleboard: gpt-image-2
    options:
      resolution: 4K
      size: "16:9"
      roleboard_size: "16:9"
      roleboard_resolution: 4K
      key_vision_size: "9:16"
      key_vision_resolution: 4K
      prop_size: "1:1"
      prop_resolution: 2K
      prop_image_generation_concurrency: 3
      layout_size: "9:16"
      layout_resolution: 4K
      response_format: url
      n: 1
      toapi_max_attempts: 10
      toapi_retry_initial_delay_seconds: 2
      toapi_retry_max_delay_seconds: 30
      toapi_reference_upload_max_attempts: 5
      toapi_reference_upload_retry_initial_delay_seconds: 2
      toapi_reference_upload_retry_max_delay_seconds: 30
      poll_interval_seconds: 3
      max_wait_seconds: 900

  deepseek:
    base_url: https://api.deepseek.com
    api_key_env: DEEPSEEK_API_KEY
    models:
      text: deepseek-v4-pro
      shot: deepseek-v4-pro
    options:
      reasoning_effort: max
      thinking_enabled: true
      shot_reasoning_effort: max
      shot_thinking_enabled: true

  google:
    base_url: https://generativelanguage.googleapis.com
    api_key_env: GOOGLE_API_KEY
    models:
      text: gemini-3.5-flash
      postgen_edit_plan: gemini-3.5-flash
    options:
      response_format: json_object
      temperature: 0.2
      max_output_tokens: 8192

  minimax:
    base_url: https://api.minimaxi.com
    api_key_env: MINIMAX_API_KEY
    group_id_env: MINIMAX_GROUP_ID
    models:
      tts: speech-02
      music: music-2.6
    options:
      music_format: mp3
      music_sample_rate: 44100
      music_bitrate: 256000
      output_format: url
      is_instrumental: true
      lyrics_optimizer: false
      aigc_watermark: false
      music_timeout_seconds: 600

  elevenlabs:
    base_url: https://api.elevenlabs.io
    api_key_env: ELEVENLABS_API_KEY
    models:
      music: music_v1
    options:
      output_format: mp3_44100_128
      force_instrumental: true
      respect_sections_durations: true
      music_timeout_seconds: 600

  volcengine:
    base_url: https://openspeech.bytedance.com
    region: cn-beijing
    api_key_env: VOLCENGINE_API_KEY
    app_id_env: VOLCENGINE_APP_ID
    access_key_env: VOLCENGINE_ACCESS_KEY
    secret_key_env: VOLCENGINE_SECRET_KEY
    models:
      speech_synthesis: seed-tts-2.0
      speech_synthesis_fallback: seed-tts-1.0
      voice_design: voice_design
      voice_clone: voice_clone
      tts: seed-icl-2.0
      target_model: seed-icl-2.0
      clone_target_model: seed-icl-2.0
      image: doubao-seedream-5-0-260128
      key_vision: doubao-seedream-5-0-260128
      seedream_5: doubao-seedream-5-0-260128
      seedream_5_lite: doubao-seedream-5-0-lite-260128
      video: doubao-seedance-2-0-260128
      seedance_2: doubao-seedance-2-0-260128
      upscale: video-upscale
    options:
      language: cn
      sample_rate: 24000
      response_format: mp3
      max_generated_audio_duration_seconds: 10
      role_voice_preview_text_chars: 40
      seed_tts_api_key_env: SEED_TTS_API_KEY
      seedream_base_url: https://ark.cn-beijing.volces.com
      seedream_api_key_env: VOLCENGINE_API_KEY
      seedream_image_size: 1600x2848
      seedream_key_vision_size: 1600x2848
      seedream_roleboard_size: 2848x1600
      seedream_prop_size: 2048x2048
      seedream_layout_size: 1600x2848
      seedream_output_format: png
      seedream_response_format: url
      seedream_watermark: false
      seedream_sequential_image_generation: disabled
      seedream_max_reference_images: 14
      seedance_base_url: https://ark.cn-beijing.volces.com
      seedance_api_key_env: VOLCENGINE_API_KEY
      video_ratio: "9:16"
      video_resolution: 720p
      # Seedance video refs use the shot manifest's keyframe as the first fixed image input.
      # Kling subject mode submits the keyframe plus role/layout/prop references;
      # roles are submitted separately as subject elements.
      video_reference_mode: full
      previous_video_preroll_seconds: 0
      # Seedance image-reference limit. Kling uses its node-specific combined
      # subject/first-frame/last-frame/refer-image budget instead.
      max_reference_images: 3
      max_reference_audio: 1
      max_reference_audio_duration_seconds: 15.2
      max_reference_videos: 2
      max_reference_video_total_duration_seconds: 15.2
      video_poll_interval_seconds: 30
      return_last_frame: true
      generate_audio: false
      video_min_duration_seconds: 4
      video_max_duration_seconds: 10
      tts_resource_id: seed-tts-2.0
      tts_fallback_resource_id: seed-tts-1.0
      instruction_mode: none
      additions_as_json_string: true
      default_speaker: zh_male_m191_uranus_bigtts
      default_male_speaker: zh_male_m191_uranus_bigtts
      default_female_speaker: zh_female_xiaohe_uranus_bigtts
      role_speakers: {}
      emotion_instructions:
        normal:
          emotion: neutral
          emotion_scale: 2
          speech_rate: 0
          loudness_rate: 0
          instruction: 自然、克制、口语化，像影视短剧对白，保持角色身份感。
        tense:
          emotion: tension
          emotion_scale: 4
          speech_rate: 6
          loudness_rate: -2
          instruction: 压低声音，呼吸略紧，像强忍情绪，语尾收住，不要夸张表演。
        angry:
          emotion: angry
          emotion_scale: 4
          speech_rate: 5
          loudness_rate: 4
          instruction: 愤怒但不要吼叫，语气锋利，停顿短促，压迫感强。
        sad:
          emotion: sad
          emotion_scale: 4
          speech_rate: -8
          loudness_rate: -4
          instruction: 低落、疲惫，语速稍慢，尾音略沉，带一点忍住不哭的感觉。
        happy:
          emotion: happy
          emotion_scale: 3
          speech_rate: 4
          loudness_rate: 2
          instruction: 轻松、有笑意，节奏明快，但不要广告腔。
        whisper:
          emotion: ASMR
          emotion_scale: 3
          speech_rate: -10
          loudness_rate: -8
          instruction: 贴近耳语，音量较低，气声更明显，但吐字保持清晰。
        low:
          emotion: neutral
          emotion_scale: 3
          speech_rate: -6
          loudness_rate: -4
          instruction: 压低声线，声音低沉克制，带私密感或压迫感，但不是耳语，吐字保持清晰。
        other:
          emotion: neutral
          emotion_scale: 2
          speech_rate: 0
          loudness_rate: 0
          instruction: 按角色设定自然表达，根据文本上下文微调情绪。
      # Only used by the legacy Volcengine voice design/clone provider.
      speaker_id_pool: []
      poll_interval_seconds: 5
      max_polls: 60
      voice_clone_extra_params:
        voice_clone_denoise_model_id: ""
        enable_audio_denoise: false

  kling:
    base_url: https://api-beijing.klingai.com
    api_key_env: KLING_API_KEY
    models:
      video: kling-v3-omni
      subject_element: advanced-custom-elements
    options:
      # official_v3 uses /omni-video/kling-3.0-omni and /tasks from kling_omni_pipeline.md.
      api_schema: official_v3
      mode: pro
      resolution: 1080p
      aspect_ratio: "9:16"
      duration: 5
      sound: native
      multi_shot: true
      watermark: false
      video_reference_mode: shot_keyframe
      subject_reference_type: image_refer
      subject_video_duration_seconds: 5
      # Combined budget for subject elements, first/last frames, and refer_image inputs.
      max_reference_images: 7
      max_reference_elements: 3
      require_dialogue_voice: true
      # On first use, cache the official Kling voice list and trial clips under
      # .assets/voice_catalog/kling_omni/kling-v3-omni/. Reuse the cache offline.
      auto_select_official_voice: true
      refresh_official_voice_catalog: false
      download_official_voice_trials: true
      official_voice_download_concurrency: 8
      # Preserve every official trial; when it is shorter than 5s, use the same
      # Kling voice_id with /v1/audio/tts to build an approximately 8s normal sample.
      synthesize_short_official_voice_trials: true
      official_voice_min_sample_seconds: 5
      official_voice_tts_target_seconds: 8
      # /v1/general/presets-voices and /v1/audio/tts use different ID spaces.
      # Key: Omni preset voice_id; value: officially mapped avatar TTS voice_id.
      official_voice_tts_map: {}
      # Set false only when the machine's HTTP(S) proxy breaks Kling TLS.
      httpx_trust_env: true
      # Key by stable role_id (preferred) or exact role name.
      # Manual mappings override automatic official-voice selection.
      # A string is an existing Kling preset/custom voice_id.
      # An object with voice_url creates a custom voice from a public 5-30 second clean sample.
      role_voice_map: {}
      # role_voice_map:
      #   role_江未晞: "850087542757535834"
      #   role_九韶:
      #     voice_name: 九韶
      #     voice_url: https://your-cdn.example.com/jiushao-clean-voice.wav
      poll_interval_seconds: 10
      max_polls: 120

routing:
  text:
    script: rightcode
    director: rightcode
    role: rightcode
    role_voice_select: rightcode
    prop: rightcode
    layout: rightcode
    shot: rightcode
    postgen_edit_plan: google
    postgen_audit: aibox
    edit_plan: rightcode
    bgm_plan: rightcode
  image:
    # Reusable global assets and shot-level reference-image generation.
    role: aibox
    key_vision: aibox
    shot: aibox
    prop: aibox
    layout: aibox
  video:
    shot: volcengine
    upscale: volcengine
  audio:
    speech: volcengine
    music: minimax
  music:
    bgm: minimax
  judge:
    voice_catalog_profile: aliyun_omni
    role_voice_select: aliyun_omni
  vision:
    media_review: aliyun
