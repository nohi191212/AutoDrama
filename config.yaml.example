app:
  env: dev
  default_quality_preset: cheap
  enable_human_review: false

project:
  # Stable ID is recommended because resume relies on it.
  id: review_demo
  title: 测试短片
  script_outline_file: ./inputs/story_outline.md
  # The script pipeline lets the text model split the story into this many episodes.
  episode_count: 1
  # Target duration for each episode, in seconds.
  episode_duration_seconds: 30

output:
  # All generated assets are saved under this directory.
  # Relative paths are resolved from the working directory.
  root_dir: ./outputs
  project_dir_template: "{date}_{slug}"
  db_filename: autodrama.sqlite
  subdirs:
    logs: logs
    assets: assets
    outputs: outputs
    images: assets/images
    videos: assets/videos
    audios: assets/audios
    json: assets/json

runtime:
  python:
    # The key is selected by scripts/env.sh after platform detection.
    # Supported keys: windows, macos, linux, default.
    windows: D:/miniforge3/envs/autodrama/python.exe
    linux: python3
    macos: python3
    default: python3
  max_text_retry: 3
  max_media_retry: 2
  request_timeout_seconds: 120
  ffmpeg_path: ffmpeg

budget:
  max_total_cny: 100
  max_image_count: 20
  max_video_seconds: 45
  max_music_count: 5
  max_text_calls: 200

providers:
  qwen:
    base_url: https://dashscope.aliyuncs.com/compatible-mode/v1
    api_key_env: DASHSCOPE_API_KEY
    models:
      text: qwen-plus
    options:
      response_format: true

  qwen_tts:
    base_url: https://dashscope.aliyuncs.com/api/v1/services/audio/tts/customization
    api_key_env: DASHSCOPE_API_KEY
    models:
      voice_design: qwen-voice-design
      target_model: qwen3-tts-vd-realtime-2026-01-15
    options:
      language: zh
      sample_rate: 24000
      response_format: wav

  deepseek:
    base_url: https://api.deepseek.com
    api_key_env: DEEPSEEK_API_KEY
    models:
      text: deepseek-v4-pro
    options:
      reasoning_effort: high
      thinking_enabled: true

  bailian:
    base_url: https://dashscope.aliyuncs.com
    api_key_env: BAILIAN_API_KEY
    models:
      text: qwen-max
      vision: qwen-vl-max
      omni: qwen-omni-turbo

  wanxiang:
    base_url: https://dashscope.aliyuncs.com/api/v1
    api_key_env: DASHSCOPE_API_KEY
    models:
      text_to_video: wan2.7-t2v-2026-04-25
    options:
      resolution: 720P
      ratio: "16:9"
      prompt_extend: true
      watermark: false
      poll_interval_seconds: 15
      max_polls: 80

  minimax:
    base_url: https://api.minimax.chat
    api_key_env: MINIMAX_API_KEY
    group_id_env: MINIMAX_GROUP_ID
    models:
      tts: speech-02
      music: music-01

  volcengine:
    region: cn-beijing
    access_key_env: VOLCENGINE_ACCESS_KEY
    secret_key_env: VOLCENGINE_SECRET_KEY
    models:
      image: seedream-lite
      video: seedance-lite
      upscale: video-upscale

routing:
  text:
    script: qwen
    role: deepseek
    prop: deepseek
    layout: deepseek
    storyboard: deepseek
    edit_plan: bailian
    bgm_plan: bailian
  image:
    role: volcengine
    prop: volcengine
    layout: volcengine
    ref_frame: volcengine
  video:
    shot: wanxiang
    upscale: volcengine
  audio:
    speech: qwen_tts
    music: minimax
  vision:
    media_review: bailian
